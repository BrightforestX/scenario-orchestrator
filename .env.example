# SurrealDB Configuration
SURREALDB_URL=ws://localhost:8000
SURREALDB_NAMESPACE=buzz
SURREALDB_DATABASE=scenarios
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=root

# Baseten Configuration
BASETEN_API_KEY=your_baseten_api_key
BASETEN_CHAIN_ENDPOINT=https://model-xxx.api.baseten.co/production/predict

# Daytona Configuration
DAYTONA_API_KEY=your_daytona_api_key
DAYTONA_TARGET_REGION=us

# Buzz Configuration
BUZZ_RELAY_URL=ws://localhost:3000
BUZZ_PRIVATE_KEY=your_nostr_private_key_hex
BUZZ_DEFAULT_CHANNEL=scenario-results

# Orchestrator Configuration
POLL_INTERVAL_SECONDS=30
FUNCTION_TRIGGER_PORT=8080
LOG_LEVEL=INFO

# Pipeline Configuration (Durable Scenario Analysis MVP)
PIPELINE_STAGING_DIR=/tmp/scenario-pipeline
PIPELINE_TRINO_HOST=localhost
PIPELINE_TRINO_PORT=8080
PIPELINE_TRINO_USER=pipeline
PIPELINE_TRINO_CATALOG=hive
PIPELINE_TRINO_SCHEMA=default

# Temporal Configuration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=scenario-pipeline
TEMPORAL_PIPELINE_API_URL=http://localhost:8080
TEMPORAL_GATE_URL=http://localhost:8090/v1/gate
TEMPORAL_USE_INLINE_GATE=0

# Gate Service (TypeScript keep-or-revert judge)
GATE_PORT=8090
GATE_DEFAULT_MIN_SCORE=0.0
